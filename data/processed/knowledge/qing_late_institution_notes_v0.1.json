      "title_zh": "清末的省",
      "body_zh": "清末的省是内地地方治理的重要上层单元，巡抚主持一省政务，部分省份另受总督统辖。晚清又在新疆和东北陆续建省；藩部和其他特殊区域并不都采用同一套省制。",
      "matching": {
        "raw_types": [
          "省",
          "省级"
        ],
        "year_from": 1901,
        "year_to": 1911,
        "spatial_scope": "清末实行省制的地区；正文已明确提示非省制区域",
        "auto_match_enabled": true
      },
      "source_ids": [
